# GO_VERSION is required: make and the release workflow pass the exact go.work
# version. Microsoft's version-free tags trail Go feature releases, so there is
# no usable default.
ARG GO_VERSION
ARG GO_VARIANT=azurelinux3.0
ARG RUNTIME_IMAGE=mcr.microsoft.com/azurelinux/base/core:3.0

FROM mcr.microsoft.com/oss/go/microsoft/golang:${GO_VERSION}-${GO_VARIANT} AS builder
ENV CGO_ENABLED=0
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
ARG VERSION=dev
RUN CGO_ENABLED=0 go build -trimpath \
    -ldflags "-s -w -X main.version=${VERSION}" \
    -o /aztunnel ./cmd/aztunnel && \
    go test -c -o /trust.test ./internal/trustcheck

FROM ${RUNTIME_IMAGE} AS runtime
# Keep cryptography and trust roots owned by the runtime OS packages.
RUN tdnf upgrade -y && tdnf install -y openssl-libs ca-certificates && tdnf clean all

FROM runtime AS checked
COPY --from=builder /aztunnel /aztunnel
COPY --from=builder /trust.test /trust.test
RUN ["/trust.test", "-test.v", "-ca-bundle=/etc/pki/tls/certs/ca-bundle.crt", "-artifact=/aztunnel"]

FROM runtime
COPY --from=checked /aztunnel /usr/local/bin/aztunnel
ENTRYPOINT ["aztunnel"]
